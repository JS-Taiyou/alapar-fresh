{
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": [
    "**/_fresh/*",
    "node_modules/",
    "vendor/"
  ],
  "imports": {
    "@/": "./",
    "./lib/db.ts": "./test/fixtures/db_stub.ts",
    "@supabase/supabase-js": "./test/fixtures/supabase_stub.ts",
    "@types/pg": "npm:@types/pg@^8.20.0",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "pg": "npm:pg@^8.20.0",
    "preact": "npm:preact@10.29.1",
    "@preact/signals": "npm:@preact/signals@2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "vite": "npm:vite@^7.3.2",
    "tailwindcss": "npm:tailwindcss@4.2.2",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.2.2",
    "daisyui": "npm:daisyui@^5.0.0",
    "driver.js": "npm:driver.js@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing": "jsr:@std/testing@^1"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"],
    "skipLibCheck": true
  }
}
