/**
 * Type-check-only config (used by `deno task check:types` and CI).
 *
 * WHY THIS EXISTS: the npm registry currently serves corrupted metadata for
 * @tailwindcss/oxide-wasm32-wasi (duplicate `bundleDependencies` JSON field),
 * which makes any resolution touching tailwindcss fail — including
 * `deno install` with the main deno.json (whose import map contains
 * tailwindcss/daisyui/vite for the BUILD chain).
 *
 * The app's runtime code never imports those three — only vite.config.ts
 * does, and it is NOT a check target. This config omits them so
 * `deno install --no-lock --config deno.check.jsonc` succeeds and
 * `deno check` gets REAL npm type declarations (pg, preact, supabase-js…)
 * instead of the degraded `any` fallback that cache-only resolution gives.
 *
 * When the registry bug resolves, delete this file and go back to plain
 * `deno install && deno check` (which also covers vite.config.ts).
 *
 * Kept in sync with deno.json's relevant entries; check targets:
 *   main.ts utils.ts client.ts lib/ islands/ components/ routes/ test/
 */
{
  "nodeModulesDir": "manual",
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": [
    "**/_fresh/*",
    "node_modules/",
    "vendor/",
    ".kilo/",
    ".zcode/"
  ],
  "imports": {
    "@/": "./",
    "@types/pg": "npm:@types/pg@^8.20.0",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "pg": "npm:pg@^8.20.0",
    "preact": "npm:preact@10.29.1",
    "@preact/signals": "npm:@preact/signals@2.9.0",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.49.0",
    "driver.js": "npm:driver.js@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing": "jsr:@std/testing@^1"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "skipLibCheck": true
  }
}
